# ---------------------------------------------------------------------------
# Copy to .env and adjust. Every value here is a placeholder: no real
# credential belongs in this file, in this repository, or in any commit.
# ---------------------------------------------------------------------------

# Driver: "sqlite" runs with no external service (used by `make demo` and the
# test suite). "mysql" is the production-shaped path, started by Docker Compose.
DB_DRIVER=sqlite
DB_SQLITE_PATH=var/relay.sqlite

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=relay
DB_USER=relay
DB_PASSWORD=replace-me

# Shared secret used to sign inbound webhooks (HMAC-SHA256, base64, over the
# raw request body). Generate with: openssl rand -hex 32
WEBHOOK_SECRET=replace-with-32-bytes-of-randomness

# Bearer token for service-to-service calls to the admin endpoints.
INTERNAL_SERVICE_TOKEN=replace-with-a-long-random-string

# --- Queue tuning ----------------------------------------------------------
# How many orders a worker claims per cycle.
QUEUE_BATCH_SIZE=20
# How long a claim is held before another worker may take the order back.
QUEUE_LEASE_SECONDS=300
# Attempts before an order is parked in dead_letter for a human.
QUEUE_MAX_ATTEMPTS=5
# First retry delay in seconds; doubles each attempt, with jitter.
QUEUE_BACKOFF_BASE_SECONDS=10
QUEUE_BACKOFF_MAX_SECONDS=3600

# --- Downstream system of record (fictional) --------------------------------
# "fake" keeps everything in-process and is what the demos and tests use.
# "http" talks to a real Atlas ERP deployment.
ERP_DRIVER=fake
ERP_BASE_URL=https://atlas-erp.example.invalid/api
ERP_API_KEY=replace-me
ERP_TIMEOUT_SECONDS=30

LOG_LEVEL=info
